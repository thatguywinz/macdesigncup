{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/portal/:path*", "destination": "/api/portal?__path=:path*" },
    { "source": "/submit", "destination": "/portal" },
    { "source": "/submit/:path*", "destination": "/portal" },
    { "source": "/entry/:path*", "destination": "/portal" },
    { "source": "/gallery", "destination": "/portal" },
    { "source": "/submissions", "destination": "/portal" },
    { "source": "/judge", "destination": "/portal" },
    { "source": "/judge/:path*", "destination": "/portal" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(hero|lion)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(favicon\\.png|apple-touch-icon\\.png|og-image\\.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' https://tally.so; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://tally.so https://api.tally.so data: blob:; frame-src https://tally.so; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://tally.so; object-src 'none'"
        }
      ]
    },
    {
      "source": "/(submit|submissions|entry|gallery|judge|portal)(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.blob.vercel-storage.com https://i.ytimg.com; media-src 'self' blob: https://*.blob.vercel-storage.com; frame-src https://www.youtube-nocookie.com https://player.vimeo.com https://drive.google.com https://www.loom.com; font-src 'self' data:; connect-src 'self' blob: data: https://*.blob.vercel-storage.com https://vercel.com; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": { "eq": "www.macdesigncup.ca" } }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
